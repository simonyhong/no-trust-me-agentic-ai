# Copy this file to .env, then replace the placeholder values in .env.
# Keep .env private: it is ignored by Git and must never be committed.
#
# Format rules:
# - one KEY=value assignment per line
# - quotes are not required
#
# Example:
# AZURE_OPENAI_API_KEY=your-real-key

AZURE_OPENAI_API_KEY=replace-with-your-real-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional debug behavior. Set to 1 to delete local done-state on startup.
RESET_DONE_STATE=0

# Cumulative seconds of non-GPT computation per function invocation.
# Set to 0 to disable this compute-only watchdog.
FUNCTION_CALL_TIMEOUT_SECONDS=120

# Total seconds per function invocation, INCLUDING all GPT waits.
# Set to 0 to disable. Prevents loops of GPT calls from running indefinitely.
FUNCTION_TOTAL_WALL_TIMEOUT_SECONDS=300

# Maximum approved GPT tool calls per function invocation, 0 to disable.
MAX_GPT_CALLS_PER_FUNCTION=5

# Give cancelled function code a short chance to stop before force-killing.
# If a GPT semaphore slot is held, the manager waits for the API deadline.
FUNCTION_CANCELLATION_GRACE_SECONDS=3

# GPT external-tool budgets, independent of the function computation watchdog.
# Total per GPT interaction (slot wait, API calls and retry backoffs): seconds.
GPT_TOOL_TIMEOUT_SECONDS=180
# Maximum seconds for one GPT API request.
GPT_REQUEST_TIMEOUT_SECONDS=60

# Code-generation requests get a separate five-minute request timeout.
# Total generation interaction (including retries) may take ten minutes.
# This is a shared budget across attempts; two full five-minute requests
# are not guaranteed once slot waiting and backoff are included.
GPT_GENERATION_REQUEST_TIMEOUT_SECONDS=300
GPT_GENERATION_TOOL_TIMEOUT_SECONDS=600
# Maximum seconds to wait for an available shared GPT slot per attempt.
GPT_SEMAPHORE_WAIT_TIMEOUT_SECONDS=60

# Maximum actionable job records per BRD worker before yielding the slot.
# Default: 25; the next worker session resumes via done-state.
MAX_JOBS_PER_WORKER_SESSION=25
