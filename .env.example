# Copy this file to .env, then replace the placeholder values in .env.
# Keep .env private: it is ignored by Git and must never be committed.
#
# Format rules:
# - one KEY=value assignment per line
# - no trailing commas
# - quotes are not required
#
# Example:
# AZURE_OPENAI_API_KEY=your-real-key

AZURE_OPENAI_API_KEY=replace-with-your-real-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional debug behavior. Set to 1 to delete local done/results runtime state on startup.
RESET_DONE_STATE=0
