# Copy this file to .env and put your real local values in .env.
# Never put a real API key in .env.example and never commit .env.

AZURE_OPENAI_API_KEY=replace-with-your-real-key-in-dot-env
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional debug behavior. Set to 1 to delete local done/results runtime state on startup.
RESET_DONE_STATE=0
